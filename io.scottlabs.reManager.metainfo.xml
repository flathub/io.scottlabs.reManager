<component type="desktop-application">
  <id>io.scottlabs.reManager</id>
  <name>reManager</name>
  <summary>Manage mods on reMarkable tablets</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.scottlabs">
    <name>Mitchell Scott</name>
  </developer>
  <description>
    <p>A multi-platform desktop app for managing mods on reMarkable tablets.
      Powered by the Vellum package manager.</p>
    <p>Features:</p>
    <ul>
      <li>Multi-Device Management: Save multiple sets of SSH credentials with password or key-based authentication</li>
      <li>Package Management: Browse, install, upgrade, and uninstall packages with automatic dependency resolution</li>
      <li>Maintenance Tools: Enable/disable auto-updates, set timezone, run package-provided scripts</li>
      <li>Interactive Terminal: Access a complete shell session on your reMarkable</li>
      <li>File Browser: Browse filesystem, transfer files to and from your reMarkable</li>
      <li>Backup and Restore: Backup and restore document library and configuration</li>
      <li>Configuration Editor: Edit system configuration files with syntax highlighting</li>
    </ul>
  </description>
